# Supabase (same project as your other course apps)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AlmostCrackd Assignment 5 API
# Full URL to the caption generation endpoint (REQUIRED for testing)
ALMOSTCRACKD_GENERATE_CAPTIONS_URL=https://api.almostcrackd.ai/pipeline/generate-captions

# Optional: static API key (Bearer token)
ALMOSTCRACKD_API_KEY=

# Optional: set to "1" to forward the signed-in user's Supabase JWT instead of API key
ALMOSTCRACKD_FORWARD_SUPABASE_TOKEN=1
